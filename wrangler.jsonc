{
  // Cloudflare Workers config for the CrunchySFX web deploy (Workers Builds, connected to
  // this Git repo). Serves the site's static files (index.html, dsp.js, presets.js,
  // styles.css, og.png, …) via the ASSETS binding, with worker.js in front to render
  // per-sound Open Graph cards for ?s= share links. See worker.js for the why.
  //
  // `name` must match this project's Worker name in the Cloudflare dashboard (the part
  // before .<account>.workers.dev — here crunchysfx.sevi66.workers.dev). If your project
  // is named differently, change it or Workers Builds may create a second Worker.
  "name": "crunchysfx",
  "main": "worker.js",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Run worker.js BEFORE static-asset matching so it can intercept "/?s=…"
    // (otherwise "/" serves index.html directly and the Worker never runs).
    "run_worker_first": true
  }
}
