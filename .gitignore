# Flatpak build artifacts. The ONLY sources here are com.crunchysfx.app.yml + .metainfo.xml;
# everything else is regenerated by flatpak-builder (repo/ is an OSTree repo = ~70 binary files),
# plus the .deb build input and the built bundle. Never commit these.
flatpak/repo/
flatpak/build-dir/
flatpak/.flatpak-builder/
flatpak/*.deb
flatpak/*.flatpak

# Staging dir for the itch web-build zip (regenerable).
dist-itch/

