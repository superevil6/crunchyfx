{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core defaults plus WAV export (Save dialog + write), batch export to a chosen folder (Open dialog, directory), project files (Open dialog + read), drag-out (native drag of a temp WAV into the OS / an engine), and the Crunchy suite dialog opening its links in the OS browser (opener, scoped to the suite hosts).",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "drag:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*.sevi66.workers.dev/*"
        },
        {
          "url": "https://sevi66.itch.io/*"
        },
        {
          "url": "https://crunchytile.com/*"
        },
        {
          "url": "https://crunchyui.com/*"
        },
        {
          "url": "https://crunchysfx.com/*"
        },
        {
          "url": "https://crunchyvfx.com/*"
        },
        {
          "url": "https://crunchybgm.com/*"
        }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$TEMP/**"
        }
      ]
    }
  ]
}
